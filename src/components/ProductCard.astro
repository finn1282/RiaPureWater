---
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
  class?: string;
}

const { product, class: className } = Astro.props;
const { name, model, images, water_type, install_type, best_for } = product.data;
const chips = [water_type, install_type, best_for.length ? best_for.join(', ') : null].filter(Boolean);
---

<a href={`/product/${product.id}`} class:list={['card flex h-full flex-col no-underline', className]}>
  <div class="flex aspect-square items-center justify-center bg-surface">
    {
      images[0] ? (
        <img
          src={images[0]}
          alt={name}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-contain"
        />
      ) : (
        <span class="text-body-sm text-text-muted">Photo coming soon</span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col px-4 pb-4 pt-3.5">
    <h3 class="line-clamp-2 text-[15px] font-semibold leading-[22px] text-text-primary">{name}</h3>
    <p class="mb-2.5 text-[13px] text-text-muted">{model}</p>
    {
      chips.length > 0 && (
        <p class="mb-2.5 flex flex-wrap gap-1.5">
          {chips.map((chip) => <span class="chip">{chip}</span>)}
        </p>
      )
    }
    <span class="mt-auto text-body-sm font-semibold text-brand-green">View →</span>
  </div>
</a>
