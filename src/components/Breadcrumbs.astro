---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-3 text-[12px] text-text-muted md:py-5 md:text-[13px]">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true" class="text-[#c3c7cc]">›</span>}
          {item.href ? (
            <a href={item.href} class="text-text-muted no-underline hover:text-brand-green hover:underline">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="font-medium text-text-primary">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
