---
import '../../styles/global.css';

// Review-only page. It is built in `astro dev`, or in a deploy that sets
// SHOW_DESIGN_SYSTEM=1, so the checkpoint can be reviewed on the Vercel URL.
// Remove the variable (and this route) at Checkpoint 10.
export function getStaticPaths() {
  const enabled = import.meta.env.DEV || import.meta.env.SHOW_DESIGN_SYSTEM === '1';
  return enabled ? [{ params: { slug: undefined } }] : [];
}

const colours = [
  { token: 'brand-green', hex: '#1F6F3A', use: 'Primary buttons, headings, links, footer', cls: 'bg-brand-green' },
  { token: 'brand-green-hover', hex: '#175A2E', use: 'Button and link hover', cls: 'bg-brand-green-hover' },
  { token: 'brand-blue', hex: '#3AA9E0', use: 'WhatsApp CTA, water icons', cls: 'bg-brand-blue' },
  { token: 'brand-blue-hover', hex: '#2691CB', use: 'WhatsApp button hover', cls: 'bg-brand-blue-hover' },
  { token: 'accent-lime', hex: '#4CBD3A', use: 'Small badges only', cls: 'bg-accent-lime' },
  { token: 'text-primary', hex: '#2D3748', use: 'Body copy', cls: 'bg-text-primary' },
  { token: 'text-muted', hex: '#6B7280', use: 'Captions, labels', cls: 'bg-text-muted' },
  { token: 'surface', hex: '#F5F7F8', use: 'Alt sections, card backgrounds', cls: 'bg-surface' },
  { token: 'background', hex: '#FFFFFF', use: 'Page background', cls: 'bg-background' },
  { token: 'border', hex: '#E5E7EB', use: 'Borders, dividers', cls: 'bg-border' },
];

const type = [
  { name: 'H1', spec: '32/40 → 44/52 · 700', cls: 'text-h1 md:text-h1-lg text-brand-green' },
  { name: 'H2', spec: '24/32 → 32/40 · 700', cls: 'text-h2 md:text-h2-lg text-brand-green' },
  { name: 'H3', spec: '20/28 → 24/32 · 600', cls: 'text-h3 md:text-h3-lg' },
  { name: 'H4', spec: '16/24 · 600', cls: 'text-h4' },
  { name: 'Body large', spec: '18/28 · 400', cls: 'text-body-lg' },
  { name: 'Body', spec: '16/24 · 400', cls: 'text-body' },
  { name: 'Body small', spec: '14/20 · 400', cls: 'text-body-sm' },
  { name: 'Overline', spec: '12/16 · 600 · +0.08em', cls: 'text-overline uppercase text-brand-green' },
];

const radii = [
  { name: 'sm', px: 4, cls: 'rounded-sm' },
  { name: 'md', px: 8, cls: 'rounded-md' },
  { name: 'lg', px: 12, cls: 'rounded-lg' },
  { name: 'xl', px: 16, cls: 'rounded-xl' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.ico" />
    <title>Design system</title>
  </head>
  <body>
    <main class="container-content space-y-12 py-8 md:py-12">
      <header>
        <p class="text-overline uppercase text-brand-green">Review only</p>
        <h1 class="text-h1 md:text-h1-lg text-brand-green">Design system</h1>
        <p class="text-body-lg text-text-muted">
          Tokens and components from the brand brief, as built in code.
        </p>
      </header>

      <section aria-labelledby="colours">
        <h2 id="colours" class="mb-4 text-h2 md:text-h2-lg text-brand-green">Colour</h2>
        <ul class="grid grid-cols-2 gap-4 md:grid-cols-5">
          {colours.map((c) => (
            <li class="overflow-hidden rounded-lg border border-border">
              <div class={`h-16 ${c.cls}`}></div>
              <div class="p-3">
                <p class="text-body-sm font-semibold">{c.token}</p>
                <p class="text-body-sm text-text-muted">{c.hex}</p>
                <p class="mt-1 text-[12px] leading-4 text-text-muted">{c.use}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="type">
        <h2 id="type" class="mb-4 text-h2 md:text-h2-lg text-brand-green">Type — Inter 400 / 500 / 600 / 700</h2>
        <ul class="divide-y divide-border rounded-lg border border-border">
          {type.map((t) => (
            <li class="p-4 md:grid md:grid-cols-[200px_1fr] md:items-baseline md:gap-6">
              <p class="mb-1 text-body-sm text-text-muted md:mb-0">{t.name}<br />{t.spec}</p>
              <p class={t.cls}>Pure water for every home</p>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="shape">
        <h2 id="shape" class="mb-4 text-h2 md:text-h2-lg text-brand-green">Radius and shadow</h2>
        <ul class="flex flex-wrap gap-4">
          {radii.map((r) => (
            <li class="text-center">
              <div class={`h-16 w-24 border border-border bg-surface ${r.cls}`}></div>
              <p class="mt-2 text-body-sm text-text-muted">{r.name} · {r.px}px</p>
            </li>
          ))}
          <li class="text-center">
            <div class="h-16 w-24 rounded-lg border border-border bg-white shadow-card"></div>
            <p class="mt-2 text-body-sm text-text-muted">shadow-card</p>
          </li>
        </ul>
      </section>

      <section aria-labelledby="buttons">
        <h2 id="buttons" class="mb-4 text-h2 md:text-h2-lg text-brand-green">Buttons</h2>
        <div class="space-y-6">
          <div class="flex flex-wrap items-center gap-4">
            <a href="#buttons" class="btn btn-whatsapp">Enquire on WhatsApp</a>
            <a href="#buttons" class="btn btn-primary">Browse products</a>
            <a href="#buttons" class="btn btn-secondary">View category</a>
            <a href="#buttons" class="btn-tertiary btn">Or call 013-368 1349</a>
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <a href="#buttons" class="btn btn-lg btn-whatsapp">Large</a>
            <a href="#buttons" class="btn btn-xl btn-whatsapp">Extra large</a>
          </div>
          <p class="text-body-sm text-text-muted">We reply on WhatsApp within business hours.</p>
        </div>
      </section>

      <section aria-labelledby="chips">
        <h2 id="chips" class="mb-4 text-h2 md:text-h2-lg text-brand-green">Chips</h2>
        <div class="space-y-4">
          <p class="flex flex-wrap gap-2">
            <span class="chip">Hot &amp; Cold</span>
            <span class="chip">Tabletop</span>
            <span class="chip chip-lime">Popular</span>
          </p>
          <p class="flex flex-wrap gap-2">
            <button type="button" class="filter-chip" aria-pressed="false">Hot &amp; Cold</button>
            <button type="button" class="filter-chip" aria-pressed="true">✓ Tabletop</button>
          </p>
        </div>
      </section>

      <section aria-labelledby="cards">
        <h2 id="cards" class="mb-4 text-h2 md:text-h2-lg text-brand-green">Product card</h2>
        <div class="grid max-w-[560px] grid-cols-2 gap-4">
          {[1, 2].map((n) => (
            <a href="#cards" class="card block no-underline">
              <div class="flex aspect-square items-center justify-center bg-surface text-body-sm text-text-muted">
                Photo
              </div>
              <div class="px-4 pb-4 pt-3.5">
                <p class="line-clamp-2 text-[15px] font-semibold leading-[22px]">
                  Sample product name {n}
                </p>
                <p class="text-[13px] text-text-muted">MODEL-{n}00</p>
                <p class="mt-2 flex flex-wrap gap-1.5">
                  <span class="chip">Hot &amp; Cold</span>
                  <span class="chip">Tabletop</span>
                </p>
                <p class="mt-3 font-semibold text-brand-green">View →</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>
