---
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import { whatsappLink } from '../../lib/whatsapp';

// Review-only, same gate as /design-system. Removed at Checkpoint 10.
export function getStaticPaths() {
  const enabled = import.meta.env.DEV || import.meta.env.SHOW_DESIGN_SYSTEM === '1';
  return enabled ? [{ params: { slug: undefined } }] : [];
}

const categories = (await getCollection('categories')).sort(
  (a, b) => a.data.sort_order - b.data.sort_order,
);
const products = (await getCollection('products')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const withImages = products.filter((p) => p.data.images.length > 0).length;
const withNotes = products.filter((p) => p.data.raw_notes).length;
const sample = products[0].data;
const sampleLink = whatsappLink({ product: { name: sample.name, model: sample.model } });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Content check</title>
  </head>
  <body>
    <main class="container-content space-y-8 py-8">
      <h1 class="text-h1 text-brand-green">Content check</h1>
      <p>
        <strong>{products.length}</strong> products · <strong>{categories.length}</strong> categories ·
        {withImages} with photos · {withNotes} with raw notes
      </p>

      <table class="w-full text-body-sm">
        <thead>
          <tr class="text-left"><th>Category</th><th>Filters</th><th>Icon</th><th>Count</th></tr>
        </thead>
        <tbody>
          {categories.map((c) => (
            <tr class="border-t border-border">
              <td>{c.data.name}</td>
              <td>{c.data.show_filters ? 'shown' : 'hidden'}</td>
              <td>{c.data.icon}</td>
              <td>{c.data.product_count}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <p class="break-all text-body-sm">
        WhatsApp link for {sample.model}: <a class="underline" href={sampleLink}>{sampleLink}</a>
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-[12px] leading-4">
          <thead>
            <tr class="text-left">
              <th>id</th><th>name / model</th><th>category</th><th>water</th><th>install</th>
              <th>best for</th><th>source</th><th>KSPs</th>
            </tr>
          </thead>
          <tbody>
            {products.map((p) => (
              <tr class="border-t border-border align-top">
                <td>{p.id}</td>
                <td>{p.data.name}<br /><span class="text-text-muted">{p.data.model}</span></td>
                <td>{p.data.category}</td>
                <td>{p.data.water_type ?? '—'}</td>
                <td>{p.data.install_type ?? '—'}</td>
                <td>{p.data.best_for.join(', ') || '—'}</td>
                <td>{p.data.water_source ?? '—'}</td>
                <td>{p.data.ksps.length}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </main>
  </body>
</html>
