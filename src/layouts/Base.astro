---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  footer?: 'full' | 'slim';
  noindex?: boolean;
  /** Reserves space for a fixed mobile bar passed in the "sticky-bar" slot */
  stickyBar?: boolean;
}

const {
  title,
  description = 'Water dispensers, undersink systems and whole-house filtration from RIA Pure Water. Browse the range and enquire on WhatsApp.',
  footer = 'full',
  noindex = false,
  stickyBar = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <div class:list={[stickyBar && 'bg-brand-green pb-[calc(4.5rem+env(safe-area-inset-bottom,0px))] md:pb-0']}>
      <Footer variant={footer} />
    </div>
    <slot name="sticky-bar" />
  </body>
</html>
