---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { metaDescription } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  footer?: 'full' | 'slim';
  noindex?: boolean;
  /** Absolute path of the social share image; defaults to the RIA logo card */
  image?: string;
  /** Reserves space for a fixed mobile bar passed in the "sticky-bar" slot */
  stickyBar?: boolean;
}

const {
  title,
  description = 'Water dispensers, undersink systems and whole-house filtration from RIA Pure Water. Browse the range and enquire on WhatsApp.',
  footer = 'full',
  noindex = false,
  image = '/images/og-default.png',
  stickyBar = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const summary = metaDescription(description);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={summary} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1F6F3A" />
    <meta property="og:site_name" content="RIA Pure Water" />
    <meta property="og:locale" content="en_MY" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <div class:list={[stickyBar && 'bg-brand-green pb-[calc(4.5rem+env(safe-area-inset-bottom,0px))] md:pb-0']}>
      <Footer variant={footer} />
    </div>
    <slot name="sticky-bar" />
  </body>
</html>
